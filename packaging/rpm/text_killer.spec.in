# Packages the prebuilt, statically linked text_killer binary.
%global debug_package %{nil}
%global __os_install_post %{nil}
%global __strip /bin/true

Name:           text_killer
Version:        @VERSION@
Release:        1
Summary:        Terminal text editor with an IRC-style interface
License:        MIT
Source0:        text_killer
Source1:        text_killer.1
Source2:        text_killer.desktop
Source3:        MANUAL.txt
Source4:        LICENSE
Source5:        THIRD-PARTY-LICENSES.txt

%description
text_killer is a terminal text editor with an IRC-client look. It shows
documents as side-by-side pages (US Letter by default), highlights 93
languages, opens office documents and e-books (.odt, .docx, .xlsx, .pptx,
.rtf, .epub and more) as editable text, and saves .odt, .docx and .rtf.

%prep

%build

%install
install -Dm755 %{SOURCE0} %{buildroot}%{_bindir}/text_killer
install -Dm644 %{SOURCE1} %{buildroot}%{_mandir}/man1/text_killer.1
install -Dm644 %{SOURCE2} %{buildroot}%{_datadir}/applications/text_killer.desktop
install -Dm644 %{SOURCE3} %{buildroot}%{_docdir}/%{name}/MANUAL.txt
install -Dm644 %{SOURCE4} %{buildroot}%{_datadir}/licenses/%{name}/LICENSE
install -Dm644 %{SOURCE5} %{buildroot}%{_datadir}/licenses/%{name}/THIRD-PARTY-LICENSES.txt

%files
%{_bindir}/text_killer
%{_mandir}/man1/text_killer.1*
%{_datadir}/applications/text_killer.desktop
%{_docdir}/%{name}/MANUAL.txt
%license %{_datadir}/licenses/%{name}/LICENSE
%license %{_datadir}/licenses/%{name}/THIRD-PARTY-LICENSES.txt

%changelog
* Thu Nov 26 2026 kaiju_killer <text_killer@localhost> - 1.3.2-1
- Copyright holder kaiju_killer; credits for kaiju_killer and Claude
- Rename the mIRC theme to Classic

* Thu Nov 26 2026 kaiju_killer <text_killer@localhost> - 1.3.1-1
- Include third-party license notices; add --licenses option

* Fri Nov 20 2026 kaiju_killer <text_killer@localhost> - 1.3.0-1
- Page scaling (actual size or fill window), up to 12 pages side by side
- Page view, saved settings, page breaks, installers
